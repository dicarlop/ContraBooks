{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "schemas/**/*.ts",
    "backend/**/*.ts",
    "fyo/**/*.ts",
    "models/**/*.ts",
    "patches/**/*.ts",
    "reports/**/*.ts",
    "accounting/**/*.ts",
    "scripts/**/*.ts",
    "main/**/*.ts",
    "regional/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts",
    "dummy/**/*.ts",
    "jobs/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.vue"]
}
