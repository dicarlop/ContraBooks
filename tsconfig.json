{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "strict": true,
    "allowJs": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "schemas/*": ["schemas/*"],
      "main/*": ["main/*"],
      "backend/*": ["backend/*"],
      "regional/*": ["regional/*"],
      "fixtures/*": ["fixtures/*"],
      "reports/*": ["reports/*"],
      "models/*": ["models/*"],
      "utils/*": ["utils/*"],
      "dummy/*": ["dummy/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  },
  "ts-node": {
    "files": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "scripts/**/*.ts", "main/**/*.ts", "backend/**/*.ts", "regional/**/*.ts", "fixtures/**/*.ts", "reports/**/*.ts", "models/**/*.ts", "utils/**/*.ts", "dummy/**/*.ts"],
  "exclude": ["node_modules", "dist", "build", "uitest"]
}
